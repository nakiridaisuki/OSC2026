TARGET  ?= kernel
OBJ_DIR ?= ./build/$(TARGET)
LINKER  ?= linkers/linker.$(TARGET).ld
OBJS    := main.o boot.o \
					 string.o utils.o malloc.o sbi.o dtb.o \
					 trap_entry.o trap.o plic.o timer.o \
					 uart.o cpio.o printf.o shell.o \
					 thread.o thread_switch.o syscall.o video.o

CFLAGS := -march=rv64gc_zbb_zicbom -O3 -g
# CFLAGS += -DDEBUG

include ../common/common.mk
